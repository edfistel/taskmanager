generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  AFAZER
  EM_ANDAMENTO
  CONCLUIDO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String?
  email     String   @unique
  senha     String
  criadoEm  DateTime @default(now())

  refreshTokens RefreshToken[]
  quadros       Quadro[]
  comentarios   Comentario[]
  atribuicoes   AtribuirTarefa[]
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expiraEm   DateTime
  revogado   Boolean  @default(false)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Quadro {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  criadoEm  DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  listas Lista[]
}

model Lista {
  id        Int      @id @default(autoincrement())
  nome      String
  posicao   Int

  quadroId Int
  quadro   Quadro @relation(fields: [quadroId], references: [id])

  tarefas Tarefa[]
}

model Tarefa {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String?
  prazo     DateTime?
  posicao   Int
  status    Status   @default(AFAZER)

  listaId Int
  lista   Lista @relation(fields: [listaId], references: [id])

  subtarefas Subtarefa[]
  comentarios Comentario[]
  atribuicoes AtribuirTarefa[]
}

model Subtarefa {
  id        Int     @id @default(autoincrement())
  titulo    String
  concluida Boolean @default(false)

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  texto     String
  criadoEm  DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model AtribuirTarefa {
  id         Int      @id @default(autoincrement())
  atribuidoEm DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([tarefaId, usuarioId])
}