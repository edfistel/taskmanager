generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDO
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String?
  email    String   @unique
  senha    String
  criadoEm DateTime @default(now())

  refreshTokens RefreshToken[]
  quadros       Quadro[]
  comentarios   Comentario[]
  atribuicoes   AtribuirTarefa[]
}

model RefreshToken {
  id       Int      @id @default(autoincrement())
  token    String   @unique
  expiraEm DateTime
  revogado Boolean  @default(false)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Quadro {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  criadoEm  DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  listas Lista[]
}

model Lista {
  id      Int    @id @default(autoincrement())
  nome    String
  posicao Int

  quadroId Int
  quadro   Quadro @relation(fields: [quadroId], references: [id], onDelete: Cascade)

  tarefas Tarefa[]
}

model Tarefa {
  id        Int       @id @default(autoincrement())
  titulo    String
  descricao String?
  prazo     DateTime? @db.Date
  posicao   Int
  status    Status    @default(A_FAZER)

  listaId Int
  lista   Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)

  subtarefas  Subtarefa[]
  comentarios Comentario[]
  atribuicoes AtribuirTarefa[]
}

model Subtarefa {
  id        Int     @id @default(autoincrement())
  titulo    String
  concluida Boolean @default(false)

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
}

model Comentario {
  id       Int      @id @default(autoincrement())
  texto    String
  criadoEm DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model AtribuirTarefa {
  id          Int      @id @default(autoincrement())
  atribuidoEm DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, usuarioId])
}
