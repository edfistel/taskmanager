# Para rodar as migrations do prisma, rode o comando:
# npx prisma migrate dev --name database_structure //rodar as migrations do prisma
# npx prisma migrate reset --force //resetar o banco de dados 

DATABASE_URL="postgresql://USUARIO:SENHA@HOST:PORTA/BANCO"

# Para conectar com o banco de dados, altere as variáveis abaixo com as informações do seu banco de dados.
DB_USER=seu_usuario_do_pgadmin
DB_HOST=localhost
DB_DATABASE=nome_do_seu_banco
DB_PASSWORD=sua_senha
DB_PORT=porta_do_seu_banco