{
  "name": "taskmanager-api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "API Gateway com Express",
  "keywords": [
    "api",
    "express",
    "gateway"
  ],
  "license": "ISC",
  "author": "Eduardo Fischer, Lucas Oleques",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "node ../../services/run-db-studio.cjs gateway",
    "db:reset": "prisma db push --force-reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1"
  }
}
