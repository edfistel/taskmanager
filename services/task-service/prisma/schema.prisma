generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["tasks"]
}

enum Status {
  A_FAZER
  EM_ANDAMENTO
  CONCLUIDO

  @@schema("tasks")
}

model Quadro {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  criadoEm  DateTime @default(now())

  usuarioId Int

  listas Lista[]

  @@index([usuarioId])
  @@schema("tasks")
}

model Lista {
  id      Int    @id @default(autoincrement())
  nome    String
  posicao Int

  quadroId Int
  quadro   Quadro @relation(fields: [quadroId], references: [id], onDelete: Cascade)

  tarefas Tarefa[]

  @@schema("tasks")
}

model Tarefa {
  id        Int       @id @default(autoincrement())
  titulo    String
  descricao String?
  prazo     DateTime? @db.Date
  posicao   Int
  status    Status    @default(A_FAZER)

  listaId Int
  lista   Lista @relation(fields: [listaId], references: [id], onDelete: Cascade)

  subtarefas  Subtarefa[]
  comentarios Comentario[]
  atribuicoes AtribuirTarefa[]

  @@schema("tasks")
}

model Subtarefa {
  id        Int     @id @default(autoincrement())
  titulo    String
  concluida Boolean @default(false)

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@schema("tasks")
}

model Comentario {
  id       Int      @id @default(autoincrement())
  texto    String
  criadoEm DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  usuarioId Int

  @@index([usuarioId])
  @@schema("tasks")
}

model AtribuirTarefa {
  id          Int      @id @default(autoincrement())
  atribuidoEm DateTime @default(now())

  tarefaId Int
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  usuarioId Int

  @@unique([tarefaId, usuarioId])
  @@index([usuarioId])
  @@schema("tasks")
}
