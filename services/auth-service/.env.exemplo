# PostgreSQL real: substitua usuário, senha, host e porta pelos dados do seu servidor.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/taskmanager?schema=auth

# Use os mesmos valores de JWT_SECRET e INTERNAL_SERVICE_TOKEN nos quatro serviços.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_SEGURA
INTERNAL_SERVICE_TOKEN=SUBSTITUA_POR_UM_SEGREDO_INTERNO_COMPARTILHADO
USER_SERVICE_URL=http://localhost:3002
TASK_SERVICE_URL=http://localhost:3003
AUTH_PORT=3001
