{
  "name": "taskmanager-auth-service",
  "version": "1.0.0",
  "private": true,
  "description": "API de gerenciamento de autenticação com Express",
  "keywords": [
    "autenticação",
    "express",
    "api"
  ],
  "license": "ISC",
  "author": "Eduardo Fischer, Lucas Oleques",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "node ../../services/run-db-studio.cjs auth",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.10.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1"
  }
}
