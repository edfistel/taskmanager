generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["users"]
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String?
  email    String   @unique
  senha    String
  criadoEm DateTime @default(now())

  @@schema("users")
}
